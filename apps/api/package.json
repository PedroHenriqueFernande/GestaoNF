{
  "name": "@gestaonf/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker:dev": "tsx watch src/worker-main.ts",
    "worker:start": "tsx src/worker-main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/api.e2e.test.ts",
    "r2:check": "tsx scripts/check-r2.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.2",
    "@gestaonf/database": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "bullmq": "^6.3.11",
    "dotenv": "18.0.6",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-raw-body": "^6.0.1",
    "ioredis": "^6.0.0",
    "jose": "6.2.12",
    "openai": "^7.30.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "sharp": "^0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
