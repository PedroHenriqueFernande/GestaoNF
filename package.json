{
  "name": "gestaonf",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "backend/database"
  ],
  "scripts": {
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose stop postgres redis",
    "https:setup": "npm run https:setup -w backend",
    "frontend:dev": "npm run dev -w frontend",
    "frontend:build": "npm run build -w frontend",
    "frontend:typecheck": "npm run typecheck -w frontend",
    "frontend:test:e2e": "npm run test:e2e -w frontend",
    "backend:dev": "npm run dev -w backend",
    "backend:typecheck": "npm run typecheck -w backend",
    "backend:test": "npm run test -w backend",
    "backend:test:e2e": "npm run test:e2e -w backend",
    "db:generate": "npm run db:generate -w backend/database",
    "db:migrate": "npm run db:migrate -w backend/database",
    "db:check": "npm run db:check -w backend/database",
    "db:typecheck": "npm run typecheck -w backend/database",
    "db:test": "npm run test -w backend/database",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
