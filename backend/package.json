{
  "name": "@gestaonf/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run db:migrate --prefix database",
    "dev": "concurrently -k -n api,worker -c cyan,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "start": "tsx src/main.ts",
    "worker:start": "tsx src/worker-main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/api.e2e.test.ts",
    "https:setup": "tsx scripts/setup-local-https.ts",
    "r2:cors": "tsx scripts/update-r2-local-cors.ts",
    "r2:check": "tsx scripts/check-r2.ts",
    "email:check": "tsx scripts/check-resend.ts",
    "users:preflight": "tsx scripts/users-preflight.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@gestaonf/database": "*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "bullmq": "^6.3.11",
    "dotenv": "18.0.6",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-raw-body": "^6.0.1",
    "ioredis": "^6.0.0",
    "jose": "6.2.12",
    "node-forge": "1.4.0",
    "openai": "^7.30.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "xml-crypto": "6.4.0",
    "xmllint-wasm": "5.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.11.0",
    "@types/node-forge": "1.3.14",
    "@types/pdfkit": "^0.17.6",
    "concurrently": "^10.0.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
