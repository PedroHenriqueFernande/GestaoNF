POSTGRES_DB=gestaonf
POSTGRES_USER=gestaonf
POSTGRES_PASSWORD=gestaonf_local_only
POSTGRES_PORT=5173
DATABASE_URL=postgresql://gestaonf:gestaonf_local_only@127.0.0.1:5173/gestaonf
API_PORT=4030
NODE_ENV=development
API_ORIGIN=https://localhost:4030
WEB_ORIGIN=https://localhost:3001
# Run corepack pnpm https:setup once before starting local API/frontend.
LOCAL_HTTPS_ENABLED=true
LOCAL_HTTPS_CERT_FILE=.certs/localhost.pem
LOCAL_HTTPS_KEY_FILE=.certs/localhost-key.pem
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379

# WhatsApp Business Platform (Meta Cloud API)
META_WHATSAPP_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-private-webhook-verification-token
META_ACCESS_TOKEN=
META_BUSINESS_PORTFOLIO_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WHATSAPP_ACCOUNT_ID=
META_DISPLAY_PHONE_NUMBER=55DDDNUMERO
META_GRAPH_API_VERSION=v26.0

# Nero / OpenAI Responses API
NILO_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
NILO_WORKER_CONCURRENCY=4

# Assistente de suporte (widget no sistema). Usa OPENAI_API_KEY se SUPPORT_OPENAI_API_KEY estiver vazia.
SUPPORT_AI_ENABLED=false
SUPPORT_AI_MODEL=gpt-6-luna
SUPPORT_OPENAI_API_KEY=
SUPPORT_AI_BASE_URL=
SUPPORT_DAILY_MESSAGE_LIMIT=100
REPORTS_PDF_MAX_ROWS=5000
WHATSAPP_SEND_CONCURRENCY=8

# Cloudflare R2: private images and PDFs, credentials only in api/worker
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: paste the endpoint from R2 (required for EU/FedRAMP jurisdiction)
R2_ENDPOINT=
# 1 GiB per company, including reservations and temporary uploads
R2_COMPANY_QUOTA_BYTES=1073741824

# Resend transactional e-mails: shared private credentials for api/worker
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_TEST_MODE=true
RESEND_FROM="GestãoNF <onboarding@resend.dev>"
# E-mail used to create your Resend account (only real recipient without a domain)
RESEND_TEST_RECIPIENT=
RESEND_REPLY_TO=
# Optional for sending, required for delivery status webhooks
RESEND_WEBHOOK_SECRET=
EMAIL_COMPANY_DAILY_LIMIT=100

# Invitations: AES-256 key (Base64, 32 random bytes); server-side only
EMAIL_PAYLOAD_ENCRYPTION_KEY=
EMAIL_PAYLOAD_ENCRYPTION_KEY_ID=v1
# Optional JSON map of previous key IDs to Base64 keys during rotation
EMAIL_PAYLOAD_PREVIOUS_KEYS=

# Fiscal A1 certificates: 32 random bytes encoded as Base64; only on the API/worker server
FISCAL_CERTIFICATE_ENCRYPTION_KEY=
FISCAL_CERTIFICATE_ENCRYPTION_KEY_ID=v1
FISCAL_CERTIFICATE_PREVIOUS_KEYS=

# NFS-e nacional: preview is local; official homologation emission stays disabled
# until the current SEFIN contract and ICP-Brasil chain are verified.
NFSE_HOMOLOGATION_ENABLED=false
NFSE_CONTRACT_CONFIRMED=false
# Official SEFIN restricted-production API base path, excluding /nfse.
NFSE_SEFIN_HOMOLOGATION_URL=
# Explicit signature profile required by the current official API contract.
NFSE_SIGNATURE_PROFILE=
# PEM bundle of trusted ICP-Brasil roots on the API/worker host.
NFSE_ICP_BRASIL_CA_BUNDLE=
# Explicit local activation; always ignored in production
ACCOUNTS_ALLOW_LOCAL_ACTIVATION=false
