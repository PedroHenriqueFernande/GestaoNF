POSTGRES_DB=gestaonf
POSTGRES_USER=gestaonf
POSTGRES_PASSWORD=gestaonf_local_only
POSTGRES_PORT=15432
DATABASE_URL=postgresql://gestaonf:gestaonf_local_only@127.0.0.1:15432/gestaonf
API_PORT=3000
NODE_ENV=development
API_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
REDIS_URL=redis://127.0.0.1:6379

# WhatsApp Business Platform (Meta Cloud API)
META_WHATSAPP_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-private-webhook-verification-token
META_ACCESS_TOKEN=
META_BUSINESS_PORTFOLIO_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WHATSAPP_ACCOUNT_ID=
META_DISPLAY_PHONE_NUMBER=55DDDNUMERO
META_GRAPH_API_VERSION=v26.0

# Nero / OpenAI Responses API
NILO_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
NILO_WORKER_CONCURRENCY=4
WHATSAPP_SEND_CONCURRENCY=8

# Cloudflare R2: private images and PDFs, credentials only in api/worker
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: paste the endpoint from R2 (required for EU/FedRAMP jurisdiction)
R2_ENDPOINT=
# 1 GiB per company, including reservations and temporary uploads
R2_COMPANY_QUOTA_BYTES=1073741824

# Resend transactional e-mails: shared private credentials for api/worker
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_TEST_MODE=true
RESEND_FROM="GestãoNF <onboarding@resend.dev>"
# E-mail used to create your Resend account (only real recipient without a domain)
RESEND_TEST_RECIPIENT=
RESEND_REPLY_TO=
# Optional for sending, required for delivery status webhooks
RESEND_WEBHOOK_SECRET=
EMAIL_COMPANY_DAILY_LIMIT=100

# Invitations: AES-256 key (Base64, 32 random bytes); server-side only
EMAIL_PAYLOAD_ENCRYPTION_KEY=
EMAIL_PAYLOAD_ENCRYPTION_KEY_ID=v1
# Optional JSON map of previous key IDs to Base64 keys during rotation
EMAIL_PAYLOAD_PREVIOUS_KEYS=
# Explicit local activation; always ignored in production
ACCOUNTS_ALLOW_LOCAL_ACTIVATION=false
